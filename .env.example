# Local development environment for Raid Night Planner.
# Copy to .env and fill in. Only the Supabase client values live here —
# webhook credentials and other private keys are set as project secrets in
# the hosting environment, never in this file.

# Supabase project (Settings -> General -> External Supabase)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_pub...here

# Server-side equivalents used by migrations and tooling
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_pub...here

# Grok Bot nudge webhook — set as project secrets, listed here for reference:
# GROKBOT_WEBHOOK_URL=
# GROKBOT_WEBHOOK_TOKEN=
